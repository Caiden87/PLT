<article class="card card--product">
  <a href="{{ product.url }}" class="card__link">
    <div class="card__art card__art--photo">
      {% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '320,480,720', alt: product.featured_image.alt | default: product.title }}{% else %}<span class="stitch-icon">🪡</span>{% endif %}
      {% unless product.available %}<span class="card__soldout">Sold out</span>{% endunless %}
    </div>
    <h3>{{ product.title }}</h3><span class="card__price">{{ product.price | money }}</span>
  </a>
  <a class="card__add{% unless product.available %} is-disabled{% endunless %}" href="{{ product.url }}">{% if product.available %}{% if product.has_only_default_variant %}View product{% else %}Choose options{% endif %}{% else %}Sold out{% endif %}</a>
</article>
