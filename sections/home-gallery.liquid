{% assign instagram_url = section.settings.instagram_url | default: 'https://www.instagram.com/pettylittlethingsoc' %}
<section id="gallery" class="section gallery"><div class="container">
  <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow }}</p><h2 class="section__title">{{ section.settings.heading }} <span class="script">{{ section.settings.script_heading }}</span></h2>
  <p class="section__sub">{{ section.settings.subheading }}</p>
  <div class="gallery__grid" id="ig-feed" data-feed-id="{{ section.settings.behold_feed_id | escape }}" aria-live="polite">{% for i in (1..6) %}<a href="{{ instagram_url }}" target="_blank" rel="noopener" class="gallery__item gallery__item--{{ i }}"><span>View on Instagram</span></a>{% endfor %}</div>
  {% if section.settings.follow_text != blank %}<p class="gallery__follow">{{ section.settings.follow_text }} <a href="{{ instagram_url }}" target="_blank" rel="noopener">@pettylittlethingsoc</a></p>{% endif %}
</div></section>
{% schema %}
{"name":"Instagram gallery","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"the receipts"},{"type":"text","id":"heading","label":"Heading","default":"Recent"},{"type":"text","id":"script_heading","label":"Script heading","default":"stitch work."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Straight from the studio — the latest from our Instagram."},{"type":"text","id":"behold_feed_id","label":"Behold feed ID","default":"JkXABb2ovsIMy6Tix6sh"},{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"text","id":"follow_text","label":"Follow text","default":"Follow along"}],"presets":[{"name":"Instagram gallery"}]}
{% endschema %}
