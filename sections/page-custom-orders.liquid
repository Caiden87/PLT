<section class="service-hero service-hero--light">
  <div class="container service-hero__inner">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }} <span class="script">{{ section.settings.script_heading }}</span></h1>
    <p class="service-hero__sub">{{ section.settings.intro }}</p>
    <a href="#custom-order-form" class="btn btn--primary">{{ section.settings.hero_button }}</a>
  </div>
</section>

<section class="section service-options"><div class="container">
  <p class="eyebrow eyebrow--center">{{ section.settings.options_eyebrow }}</p>
  <h2 class="section__title">{{ section.settings.options_heading }}</h2>
  <div class="service-card-grid">{% for block in section.blocks %}{% if block.type == 'order_type' %}<article class="service-card" {{ block.shopify_attributes }}><span class="service-card__icon">{{ block.settings.icon }}</span><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{% endif %}{% endfor %}</div>
</div></section>

<section class="service-process"><div class="container">
  <p class="eyebrow eyebrow--center eyebrow--light">{{ section.settings.process_eyebrow }}</p>
  <h2 class="section__title section__title--light">{{ section.settings.process_heading }}</h2>
  <div class="menu">{% for block in section.blocks %}{% if block.type == 'step' %}<div class="menu__col" {{ block.shopify_attributes }}><h3><span class="menu__num">{{ block.settings.number }}</span> {{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div>
</div></section>

<section id="custom-order-form" class="contact service-contact"><div class="container contact__inner">
  <div class="contact__copy"><p class="eyebrow eyebrow--light">{{ section.settings.form_eyebrow }}</p><h2 class="section__title section__title--light">{{ section.settings.form_heading }} <span class="script script--light">{{ section.settings.form_script_heading }}</span></h2><p class="section__sub section__sub--light">{{ section.settings.form_intro }}</p><div class="service-note">{{ section.settings.form_note }}</div></div>
  {% form 'contact', class: 'contact__form' %}
    <input type="hidden" name="contact[Inquiry type]" value="Custom order">
    {% if form.posted_successfully? %}<p class="form__success" tabindex="-1" autofocus>{{ section.settings.success_message }}</p>{% endif %}{{ form.errors | default_errors }}
    <p class="form__section-title">Your details</p>
    <div class="form__split"><div class="form__row"><label for="CustomName-{{ section.id }}">Name *</label><input id="CustomName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required></div><div class="form__row"><label for="CustomBusiness-{{ section.id }}">Business or organization</label><input id="CustomBusiness-{{ section.id }}" type="text" name="contact[Business or organization]" autocomplete="organization"></div></div>
    <div class="form__split"><div class="form__row"><label for="CustomEmail-{{ section.id }}">Email *</label><input id="CustomEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required></div><div class="form__row"><label for="CustomPhone-{{ section.id }}">Phone</label><input id="CustomPhone-{{ section.id }}" type="tel" name="contact[Phone]" autocomplete="tel"></div></div>
    <p class="form__section-title">Project details</p>
    <div class="form__split"><div class="form__row"><label for="CustomType-{{ section.id }}">What is this order for? *</label><select id="CustomType-{{ section.id }}" name="contact[Order type]" required><option value="" selected disabled>Select one</option><option>One personalized item</option><option>Gift or small group</option><option>Birthday, trip, or celebration</option><option>Team, school, or club</option><option>Corporate or branded order</option><option>Retail or wholesale</option><option>Other / not sure yet</option></select></div><div class="form__row"><label for="CustomQuantity-{{ section.id }}">Estimated quantity *</label><input id="CustomQuantity-{{ section.id }}" type="number" min="1" name="contact[Estimated quantity]" placeholder="Example: 24" required></div></div>
    <div class="form__split"><div class="form__row"><label for="CustomItem-{{ section.id }}">What would you like embroidered? *</label><input id="CustomItem-{{ section.id }}" type="text" name="contact[Item or garment]" placeholder="Hats, sweatshirts, totes, napkins…" required></div><div class="form__row"><label for="CustomSource-{{ section.id }}">Who will provide the items?</label><select id="CustomSource-{{ section.id }}" name="contact[Item sourcing]"><option>PLT should source them</option><option>I already have the items</option><option>I need a recommendation</option><option>Not sure yet</option></select></div></div>
    <div class="form__row"><label for="CustomSizes-{{ section.id }}">Sizes and quantities by size</label><input id="CustomSizes-{{ section.id }}" type="text" name="contact[Sizes]" placeholder="Example: 2 S, 5 M, 4 L, 1 XL — or N/A"></div>
    <div class="form__row"><label for="CustomPersonalization-{{ section.id }}">What should be embroidered? *</label><textarea id="CustomPersonalization-{{ section.id }}" name="contact[Personalization or design]" rows="4" placeholder="Names, initials, wording, logo, icons, monogram style, or your overall idea." required></textarea></div>
    <div class="form__split"><div class="form__row"><label for="CustomPlacement-{{ section.id }}">Placement</label><input id="CustomPlacement-{{ section.id }}" type="text" name="contact[Placement]" placeholder="Left chest, cuff, center front…"></div><div class="form__row"><label for="CustomColors-{{ section.id }}">Colors or aesthetic</label><input id="CustomColors-{{ section.id }}" type="text" name="contact[Colors or aesthetic]" placeholder="Thread colors, event palette, mood…"></div></div>
    <div class="form__row"><label for="CustomArtwork-{{ section.id }}">Artwork or inspiration status</label><select id="CustomArtwork-{{ section.id }}" name="contact[Artwork status]"><option>I have a ready-to-use logo or design</option><option>I have inspiration photos</option><option>I would like PLT to help with the design</option><option>Not applicable</option></select><small class="form__help">After submitting, reply to our email with any logo files or inspiration photos.</small></div>
    <p class="form__section-title">Timing and budget</p>
    <div class="form__split"><div class="form__row"><label for="CustomDeadline-{{ section.id }}">In-hand date *</label><input id="CustomDeadline-{{ section.id }}" type="date" name="contact[In-hand date]" required></div><div class="form__row"><label for="CustomBudget-{{ section.id }}">Target budget</label><select id="CustomBudget-{{ section.id }}" name="contact[Target budget]"><option value="">Select a range</option><option>Under $100</option><option>$100–$250</option><option>$250–$500</option><option>$500–$1,000</option><option>$1,000+</option><option>I need guidance</option></select></div></div>
    <div class="form__row"><label for="CustomDelivery-{{ section.id }}">How would you like to receive it?</label><select id="CustomDelivery-{{ section.id }}" name="contact[Fulfillment]"><option>Local pickup in Orange County</option><option>Shipping</option><option>Not sure yet</option></select></div>
    <div class="form__row"><label for="CustomDetails-{{ section.id }}">Anything else we should know?</label><textarea id="CustomDetails-{{ section.id }}" name="contact[body]" rows="5" placeholder="Tell us about the recipient, occasion, event theme, must-haves, or any other helpful details."></textarea></div>
    <p class="form__required-note">* Required fields</p>
    <button class="btn btn--primary btn--block" type="submit">{{ section.settings.form_button }}</button>
  {% endform %}
</div></section>

{% schema %}
{
  "name":"Custom Orders page",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Small heading","default":"custom, down to the details"},{"type":"text","id":"heading","label":"Heading","default":"Made for you."},{"type":"text","id":"script_heading","label":"Script heading","default":"Down to the last stitch."},{"type":"textarea","id":"intro","label":"Introduction","default":"From one-of-one gifts to team gear and branded pieces, we turn your idea into something personal, polished, and entirely yours."},{"type":"text","id":"hero_button","label":"Button label","default":"Start a Custom Order"},
    {"type":"text","id":"options_eyebrow","label":"Options small heading","default":"choose your kind of custom"},{"type":"text","id":"options_heading","label":"Options heading","default":"What can we make together?"},
    {"type":"text","id":"process_eyebrow","label":"Process small heading","default":"how it works"},{"type":"text","id":"process_heading","label":"Process heading","default":"From idea to embroidery"},
    {"type":"text","id":"form_eyebrow","label":"Form small heading","default":"tell us everything"},{"type":"text","id":"form_heading","label":"Form heading","default":"Start your"},{"type":"text","id":"form_script_heading","label":"Form script heading","default":"custom order."},{"type":"textarea","id":"form_intro","label":"Form introduction","default":"Share the details below and we’ll follow up with availability, recommendations, and a custom quote."},{"type":"richtext","id":"form_note","label":"Form note","default":"<p>Have artwork or inspiration photos? Submit the form first and we’ll reply with the best email for attachments.</p>"},{"type":"text","id":"form_button","label":"Submit button","default":"Send My Request"},{"type":"text","id":"success_message","label":"Success message","default":"Your request is in! We’ll be in touch soon. 🎀"}
  ],
  "blocks":[
    {"type":"order_type","name":"Order type","limit":6,"settings":[{"type":"text","id":"icon","label":"Icon or emoji"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Description"}]},
    {"type":"step","name":"Process step","limit":4,"settings":[{"type":"text","id":"number","label":"Number"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Description"}]}
  ],
  "presets":[{"name":"Custom Orders page"}]
}
{% endschema %}
