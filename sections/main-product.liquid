<section class="section product-page"><div class="container product-page__grid">
  <div class="product-page__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', alt: product.featured_image.alt | default: product.title }}{% endif %}{% for media in product.media offset: 1 %}{% if media.media_type == 'image' %}{{ media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360,540,800', alt: media.alt | default: product.title }}{% endif %}{% endfor %}</div>
  <div class="product-page__info"><p class="eyebrow">{{ product.vendor }}</p><h1>{{ product.title }}</h1><p class="product-page__price">{{ product.selected_or_first_available_variant.price | money }}</p><div class="rte">{{ product.description }}</div>
    {% form 'product', product %}
      {% unless product.has_only_default_variant %}
        <label for="ProductVariant">{% if product.options contains 'Size' %}Choose size / options{% else %}Choose options{% endif %}</label>
        <select id="ProductVariant" name="id" required>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endunless %}

      {% unless product.tags contains 'no-personalization' %}
        {% if section.settings.show_personalization %}
          <div class="product-personalization">
            <label for="ProductPersonalization">{{ section.settings.personalization_label }}</label>
            {% if section.settings.personalization_help != blank %}<p class="product-personalization__help">{{ section.settings.personalization_help }}</p>{% endif %}
            <textarea id="ProductPersonalization" name="properties[Personalization details]" rows="4" placeholder="{{ section.settings.personalization_placeholder | escape }}" {% if section.settings.personalization_required %}required{% endif %}></textarea>
          </div>
        {% endif %}
      {% endunless %}

      <label for="ProductQuantity">Quantity</label><input id="ProductQuantity" type="number" name="quantity" value="1" min="1">
      <button class="btn btn--primary btn--block" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>
      {{ form | payment_button }}
    {% endform %}
  </div>
</div></section>
{% schema %}
{
  "name":"Product",
  "settings":[
    {"type":"checkbox","id":"show_personalization","label":"Show personalization box","default":true},
    {"type":"text","id":"personalization_label","label":"Personalization label","default":"Personalization details"},
    {"type":"textarea","id":"personalization_help","label":"Instructions","default":"Enter the name, initials, wording, or icon you would like. Include placement or thread-color requests, if applicable."},
    {"type":"text","id":"personalization_placeholder","label":"Placeholder text","default":"Example: WHITNEY in pink script with a small bow icon"},
    {"type":"checkbox","id":"personalization_required","label":"Require personalization before adding to cart","default":false}
  ]
}
{% endschema %}
