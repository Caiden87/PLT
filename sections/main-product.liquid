<section class="section product-page"><div class="container product-page__grid">
  <div class="product-page__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', alt: product.featured_image.alt | default: product.title }}{% endif %}{% for media in product.media offset: 1 %}{% if media.media_type == 'image' %}{{ media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360,540,800', alt: media.alt | default: product.title }}{% endif %}{% endfor %}</div>
  <div class="product-page__info"><p class="eyebrow">{{ product.vendor }}</p><h1>{{ product.title }}</h1><p class="product-page__price">{{ product.selected_or_first_available_variant.price | money }}</p><div class="rte">{{ product.description }}</div>
    {% form 'product', product %}{% unless product.has_only_default_variant %}<label for="ProductVariant">Options</label><select id="ProductVariant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<label for="ProductQuantity">Quantity</label><input id="ProductQuantity" type="number" name="quantity" value="1" min="1"><button class="btn btn--primary btn--block" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{{ form | payment_button }}{% endform %}
  </div>
</div></section>
{% schema %}{"name":"Product","settings":[]}{% endschema %}
