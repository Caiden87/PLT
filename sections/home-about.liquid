<section id="about" class="about"><div class="container about__inner">
  <div class="about__art" aria-hidden="true">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,720,900' }}{% else %}<div class="about__circle"></div><span class="about__needle">🪡</span>{% endif %}</div>
  <div class="about__copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="section__title">{{ section.settings.heading }} <span class="script">{{ section.settings.script_heading }}</span></h2><div class="rte">{{ section.settings.body }}</div>{% if section.settings.button_label != blank %}<a href="{{ section.settings.button_link | default: '#contact' }}" class="btn btn--outline">{{ section.settings.button_label }}</a>{% endif %}</div>
</div></section>
{% schema %}
{"name":"About","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Small heading","default":"the brand"},{"type":"text","id":"heading","label":"Heading","default":"A little petty."},{"type":"text","id":"script_heading","label":"Script heading","default":"A lot of talent."},{"type":"richtext","id":"body","label":"Text","default":"<p>Petty Little Things started with a needle, a grudge worth stitching about, and way too many opinions on font choice. What began as one-off gifts for friends turned into a full custom embroidery studio.</p><p>Every piece is made to order, by hand, with zero shortcuts and zero chill. If you can dream it (and it fits in a hoop), we can probably stitch it.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Let's Make Something"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"About"}]}
{% endschema %}
