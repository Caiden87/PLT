{% assign instagram_url = section.settings.instagram_url | default: 'https://www.instagram.com/pettylittlethingsoc' %}
<section id="contact" class="contact"><div class="container contact__inner">
  <div class="contact__copy"><p class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</p><h2 class="section__title section__title--light">{{ section.settings.heading }} <span class="script script--light">{{ section.settings.script_heading }}</span></h2><p class="section__sub section__sub--light">{{ section.settings.subheading }}</p><ul class="contact__details">{% if section.settings.show_instagram %}<li><strong>Instagram</strong> <a href="{{ instagram_url }}" target="_blank" rel="noopener">@pettylittlethingsoc</a></li>{% endif %}<li><strong>Based in</strong> {{ section.settings.location }}</li><li><strong>Email</strong> <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li></ul></div>
  {% form 'contact', class: 'contact__form' %}
    {% if form.posted_successfully? %}<p class="form__success" tabindex="-1" autofocus>{{ section.settings.success_message }}</p>{% endif %}{{ form.errors | default_errors }}
    <div class="form__row"><label for="ContactName-{{ section.id }}">Name</label><input type="text" id="ContactName-{{ section.id }}" name="contact[name]" value="{{ form.name | escape }}" required></div>
    <div class="form__row"><label for="ContactEmail-{{ section.id }}">Email</label><input type="email" id="ContactEmail-{{ section.id }}" name="contact[email]" value="{{ form.email | escape }}" required></div>
    <div class="form__row"><label for="ContactType-{{ section.id }}">What are you after?</label><select id="ContactType-{{ section.id }}" name="contact[Request type]"><option>Custom shop order</option><option>PLT Stitch Bar — private event</option><option>PLT Stitch Bar — corporate</option><option>Something else</option></select></div>
    <div class="form__row"><label for="ContactMessage-{{ section.id }}">Tell us more</label><textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="4" required>{{ form.body | escape }}</textarea></div>
    <button type="submit" class="btn btn--primary btn--block">{{ section.settings.button_label }}</button>
  {% endform %}
</div></section>
{% schema %}
{"name":"Contact","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"let's talk"},{"type":"text","id":"heading","label":"Heading","default":"Start your"},{"type":"text","id":"script_heading","label":"Script heading","default":"order."},{"type":"textarea","id":"subheading","label":"Description","default":"Custom piece, bulk order, or booking the Stitch Bar for your event — tell us what you're dreaming up."},{"type":"text","id":"location","label":"Location","default":"Orange County, CA"},{"type":"text","id":"email","label":"Email","default":"hello@pettylittlethings.co"},{"type":"checkbox","id":"show_instagram","label":"Show Instagram","default":true},{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"text","id":"button_label","label":"Button label","default":"Send It"},{"type":"text","id":"success_message","label":"Success message","default":"Thanks! We’ll be in touch soon. 🎀"}],"presets":[{"name":"Contact"}]}
{% endschema %}
