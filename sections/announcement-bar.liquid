{% if section.settings.show %}
  <div class="marquee" role="region" aria-label="Announcement">
    <div class="marquee__track"><span>{{ section.settings.text }}</span><span aria-hidden="true"> ✦ {{ section.settings.text }} ✦ {{ section.settings.text }} ✦ </span></div>
  </div>
{% endif %}
{% schema %}
{"name":"Announcement bar","settings":[{"type":"checkbox","id":"show","label":"Show announcement","default":true},{"type":"text","id":"text","label":"Text","default":"stitched with an attitude · made to be a little extra · petty by name, precise by nature"}]}
{% endschema %}
