<section class="hero">
  <div class="hero__blob hero__blob--one"></div><div class="hero__blob hero__blob--two"></div>
  <div class="container hero__inner">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }} <span class="script">{{ section.settings.script_heading }}</span></h1>
    <p class="hero__sub">{{ section.settings.subheading }}</p>
    <div class="hero__ctas">
      {% if section.settings.primary_label != blank %}<a href="{{ section.settings.primary_link | default: '#shop' }}" class="btn btn--primary">{{ section.settings.primary_label }}</a>{% endif %}
      {% if section.settings.secondary_label != blank %}<a href="{{ section.settings.secondary_link | default: '#stitch-bar' }}" class="btn btn--outline">{{ section.settings.secondary_label }}</a>{% endif %}
    </div>
    {% if section.settings.note != blank %}<p class="hero__tag">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>
{% if section.settings.show_strip %}<section class="strip"><div class="container strip__row">{% for block in section.blocks %}<div class="strip__item" {{ block.shopify_attributes }}><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.text }}</span></div>{% endfor %}</div></section>{% endif %}
{% schema %}
{
  "name":"Hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Small heading","default":"custom embroidery · orange county, ca"},
    {"type":"text","id":"heading","label":"Main heading","default":"Custom embroidery with a"},
    {"type":"text","id":"script_heading","label":"Script heading","default":"playful edge."},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Designed to make a statement, mark a moment, or deliver a subtle wink 🎀"},
    {"type":"text","id":"primary_label","label":"Primary button","default":"Shop the Shop"},
    {"type":"url","id":"primary_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button","default":"Book the Stitch Bar"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"},
    {"type":"text","id":"note","label":"Small note","default":"“she’s not petty, she’s precise” — every PLT customer, probably"},
    {"type":"checkbox","id":"show_strip","label":"Show highlights strip","default":true}
  ],
  "blocks":[{"type":"highlight","name":"Highlight","limit":4,"settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"text","id":"text","label":"Text"}]}],
  "presets":[{"name":"Hero","blocks":[{"type":"highlight"},{"type":"highlight"},{"type":"highlight"},{"type":"highlight"}]}]
}
{% endschema %}
