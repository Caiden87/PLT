{% assign instagram_url = section.settings.instagram | default: 'https://www.instagram.com/pettylittlethingsoc' %}
<footer class="footer">
  <div class="container footer__inner">
    <a href="{{ routes.root_url }}" class="logo logo--footer">{{ shop.name }}<span class="logo__dot">.</span></a>
    <ul class="footer__links">{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>
    <a href="{{ instagram_url }}" target="_blank" rel="noopener" class="footer__insta">Instagram ↗</a>
  </div>
  <p class="footer__bottom">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Stitched with attitude in Orange County, CA.</p>
</footer>
{% schema %}
{"name":"Footer","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"footer"},{"type":"url","id":"instagram","label":"Instagram URL"}]}
{% endschema %}
