<section id="shop" class="section shop"><div class="container">
  <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow }}</p>
  <h2 class="section__title">{{ section.settings.heading }} <span class="script">{{ section.settings.script_heading }}</span></h2>
  {% if section.settings.subheading != blank %}<p class="section__sub">{{ section.settings.subheading }}</p>{% endif %}
  {% assign featured_collection = collections[section.settings.collection] %}{% if featured_collection == blank %}{% assign featured_collection = collections.all %}{% endif %}
  <div class="shop__grid">{% for product in featured_collection.products limit: section.settings.product_limit %}{% render 'product-card', product: product %}{% else %}<p>Select a collection with products in the section settings.</p>{% endfor %}</div>
  {% if section.settings.button_label != blank %}<p class="shop__foot"><a href="{{ featured_collection.url }}" class="btn btn--outline">{{ section.settings.button_label }}</a></p>{% endif %}
</div></section>
{% schema %}
{"name":"Featured shop","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"the shop"},{"type":"text","id":"heading","label":"Heading","default":"Pick something"},{"type":"text","id":"script_heading","label":"Script heading","default":"petty."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Every piece is stitched to order — your name, your words, your energy."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"product_limit","label":"Products to show","min":4,"max":12,"step":4,"default":8},{"type":"text","id":"button_label","label":"Button label","default":"Shop all"}],"presets":[{"name":"Featured shop"}]}
{% endschema %}
