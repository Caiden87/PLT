<section class="section"><div class="container cart-page"><p class="eyebrow eyebrow--center">your picks</p><h1 class="section__title">Shopping <span class="script">cart.</span></h1>{% if cart.empty? %}<p class="section__sub">Your cart is empty. Add something petty. 🎀</p><p class="shop__foot"><a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Shop now</a></p>{% else %}{% form 'cart', cart %}<div class="cart-page__items">{% for item in cart.items %}<div class="cart-page__line"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}</a><div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title }}</p>{% endunless %}<p>{{ item.final_price | money }}</p><label for="updates_{{ item.key }}">Quantity</label><input id="updates_{{ item.key }}" data-quantity-input name="updates[]" type="number" value="{{ item.quantity }}" min="0"><p><a href="{{ item.url_to_remove }}">Remove</a></p></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-page__summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p>Shipping and taxes calculated at checkout.</p><button class="btn btn--primary" type="submit" name="checkout">Checkout</button></div>{% endform %}{% endif %}</div></section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
