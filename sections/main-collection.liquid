<section class="section"><div class="container"><p class="eyebrow eyebrow--center">the shop</p><h1 class="section__title">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="section__sub rte">{{ collection.description }}</div>{% endif %}{% paginate collection.products by 24 %}<div class="shop__grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products found.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</div></section>
